#pragma kernel Clear
#pragma kernel Advect

RWTexture3D<float> _DensityWrite;
Texture3D<float> _DensityRead;
SamplerState sampler_DensityRead;

StructuredBuffer<float4> _ObstacleCenters;
StructuredBuffer<float4> _ObstacleHeights;

int3 _GridSize;
float3 _WorldMin;
float3 _WorldSize;
float3 _Wind;
float _DeltaTime;
float _SimTime;
float _BaseDensity;
float _Dissipation;
float _Buoyancy;
float _FogHeight;
float _HeightFalloff;
float _NoiseScale;
float _NoiseStrength;
int _ObstacleCount;

float Hash31(float3 p)
{
    p = frac(p * 0.3183099 + 0.1);
    p *= 17.0;
    return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float Noise3D(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float n000 = Hash31(i + float3(0, 0, 0));
    float n100 = Hash31(i + float3(1, 0, 0));
    float n010 = Hash31(i + float3(0, 1, 0));
    float n110 = Hash31(i + float3(1, 1, 0));
    float n001 = Hash31(i + float3(0, 0, 1));
    float n101 = Hash31(i + float3(1, 0, 1));
    float n011 = Hash31(i + float3(0, 1, 1));
    float n111 = Hash31(i + float3(1, 1, 1));
    float x00 = lerp(n000, n100, f.x);
    float x10 = lerp(n010, n110, f.x);
    float x01 = lerp(n001, n101, f.x);
    float x11 = lerp(n011, n111, f.x);
    return lerp(lerp(x00, x10, f.y), lerp(x01, x11, f.y), f.z);
}

float3 GridToWorld(uint3 id)
{
    float3 uvw = (float3(id) + 0.5) / float3(_GridSize);
    return _WorldMin + uvw * _WorldSize;
}

float3 WorldToUVW(float3 worldPosition)
{
    return (worldPosition - _WorldMin) / _WorldSize;
}

void ObstacleData(float3 worldPosition, out float obstacleMask, out float3 flowVelocity)
{
    obstacleMask = 1.0;
    flowVelocity = _Wind;
    flowVelocity.y += _Buoyancy;

    [loop]
    for (int i = 0; i < 256; i++)
    {
        if (i >= _ObstacleCount)
            break;

        float4 centerRadius = _ObstacleCenters[i];
        float4 heightData = _ObstacleHeights[i];
        float2 horizontal = worldPosition.xz - centerRadius.xz;
        float horizontalDistance = length(horizontal);
        float verticalDistance = abs(worldPosition.y - heightData.x);
        float radius = max(0.02, centerRadius.w);
        float halfHeight = max(radius, heightData.y);

        if (horizontalDistance < radius && verticalDistance < halfHeight)
            obstacleMask = 0.0;

        float influence = saturate(1.0 - horizontalDistance / (radius * 3.0));
        influence *= saturate(1.0 - max(0.0, verticalDistance - halfHeight) / (radius * 3.0));
        if (influence > 0.001 && horizontalDistance > 0.001)
        {
            float3 normal = float3(horizontal.x / horizontalDistance, 0.0, horizontal.y / horizontalDistance);
            float towardObstacle = dot(flowVelocity, normal);
            // Remove the component heading into the trunk/canopy and redirect it
            // around the obstacle instead of accelerating an already-outward flow.
            flowVelocity -= normal * min(0.0, towardObstacle) * influence;
        }
    }
}

[numthreads(8, 8, 8)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y || id.z >= (uint)_GridSize.z)
        return;
    _DensityWrite[id] = 0.0;
}

[numthreads(8, 8, 8)]
void Advect(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y || id.z >= (uint)_GridSize.z)
        return;

    float3 worldPosition = GridToWorld(id);
    float obstacleMask;
    float3 localVelocity;
    ObstacleData(worldPosition, obstacleMask, localVelocity);

    // Add a small, evolving turbulent component to the wind field. This is
    // part of the voxel advection step, so the breakup moves with the density
    // instead of being a screen-space distortion.
    float3 turbulencePosition = worldPosition * (_NoiseScale * 2.4) +
        float3(_SimTime * 0.31, _SimTime * 0.17, -_SimTime * 0.23);
    float turbulenceX = Noise3D(turbulencePosition + float3(13.1, 0.0, 0.0)) - 0.5;
    float turbulenceY = Noise3D(turbulencePosition + float3(0.0, 7.3, 0.0)) - 0.5;
    float turbulenceZ = Noise3D(turbulencePosition + float3(0.0, 0.0, 19.7)) - 0.5;
    localVelocity += float3(turbulenceX, turbulenceY, turbulenceZ) * (1.25 * _NoiseStrength);

    float3 previousPosition = worldPosition - localVelocity * _DeltaTime;
    float3 previousUVW = WorldToUVW(previousPosition);
    float3 insideMask = step(0.0, previousUVW) * step(previousUVW, 1.0);
    float inVolume = insideMask.x * insideMask.y * insideMask.z;
    float advectedDensity = _DensityRead.SampleLevel(sampler_DensityRead, saturate(previousUVW), 0) * inVolume;

    float height = max(0.0, worldPosition.y - _FogHeight);
    float heightMask = exp(-height * _HeightFalloff);
    // Inject mist near the ground/source band only, and only at the upwind
    // boundary. The rest of the field is carried by advection and decays, so
    // the fog visibly enters the volume, crosses the trees, and exits downwind.
    float sourceBandHeight = max(1.0, _WorldSize.y * 0.32);
    float sourceBand = exp(-pow(height / sourceBandHeight, 2.0));
    float3 horizontalWind = float3(_Wind.x, 0.0, _Wind.z);
    float horizontalSpeed = length(horizontalWind);
    float3 windDirection = horizontalSpeed > 0.001 ? horizontalWind / horizontalSpeed : float3(1.0, 0.0, 0.0);
    float3 volumeCenter = _WorldMin + _WorldSize * 0.5;
    float alongWind = dot(worldPosition - volumeCenter, windDirection);
    float planarExtent = abs(windDirection.x) * _WorldSize.x * 0.5 +
        abs(windDirection.z) * _WorldSize.z * 0.5;
    float inletWidth = max(3.0, horizontalSpeed * 1.35);
    float inlet = 1.0 - smoothstep(-planarExtent, -planarExtent + inletWidth, alongWind);
    float pulsePhase = _SimTime * 0.42 + dot(worldPosition, windDirection) * 0.045;
    float inletPulse = smoothstep(-0.45, 0.25, sin(pulsePhase));
    float plumeNoise = Noise3D(worldPosition * (_NoiseScale * 3.0) + float3(_SimTime * 0.12, 0.0, -_SimTime * 0.09));
    inletPulse *= lerp(0.45, 1.25, plumeNoise);
    float plumeSpeed = max(1.0, horizontalSpeed * 0.42);
    float plumeDistance = fmod(_SimTime * plumeSpeed, max(1.0, planarExtent * 2.0));
    float plumeCenter = -planarExtent + plumeDistance;
    float plumeRadius = max(8.0, horizontalSpeed * 1.6);
    float movingPlume = exp(-pow((alongWind - plumeCenter) / plumeRadius, 2.0));
    float lateralAxis = windDirection.x >= 0.0 ? -windDirection.z : windDirection.z;
    float lateralAxisZ = windDirection.x >= 0.0 ? windDirection.x : -windDirection.x;
    float lateralPosition = dot(worldPosition - volumeCenter, float3(lateralAxis, 0.0, lateralAxisZ));
    float plumeSway = sin(_SimTime * 0.65 + plumeCenter * 0.035) * _WorldSize.x * 0.18;
    float lateralWidth = max(10.0, _WorldSize.x * 0.18);
    float lateralMask = exp(-pow((lateralPosition - plumeSway) / lateralWidth, 2.0));
    float verticalCenter = _FogHeight + _WorldSize.y * 0.34 + sin(_SimTime * 0.42 + plumeCenter * 0.02) * 2.0;
    float verticalWidth = max(5.0, _WorldSize.y * 0.24);
    float verticalMask = exp(-pow((worldPosition.y - verticalCenter) / verticalWidth, 2.0));
    float3 noisePosition = worldPosition * _NoiseScale + float3(_SimTime * 0.09, _SimTime * 0.015, _SimTime * 0.06);
    float noise = Noise3D(noisePosition);
    float breakup = lerp(1.0, lerp(0.35, 1.55, noise), _NoiseStrength);

    float sourceDensity = _BaseDensity * (inlet * inletPulse * verticalMask + movingPlume * lateralMask * verticalMask * 0.82) * sourceBand * heightMask * breakup;
    float decayedDensity = advectedDensity * exp(-_Dissipation * _DeltaTime);
    float result = max(decayedDensity, sourceDensity);
    result *= obstacleMask;
    _DensityWrite[id] = saturate(result);
}
