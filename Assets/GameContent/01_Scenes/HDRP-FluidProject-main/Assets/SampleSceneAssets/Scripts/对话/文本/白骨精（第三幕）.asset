  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 934c1ef0cd8351447bfb2eeb8c16fb23, type: 3}
  m_Name: "白骨精（第三幕）"
  m_EditorClassIdentifier: 
  dialoguePieces:
  - speaker: "白骨精"
    content: "早就听得讲他手段了得，今日果然话不虚传。"
    portrait: {fileID: 21300000, guid: b7f63495ebad86842a5e7da0cd1d071c, type: 3}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "白骨精"
    content: "那唐僧已经中了我的计，就要吃饭。"
    portrait: {fileID: 21300000, guid: b7f63495ebad86842a5e7da0cd1d071c, type: 3}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "白骨精"
    content: "若低头闻一闻儿，我就一把捞住，不就是我的人了？"
    portrait: {fileID: 21300000, guid: b7f63495ebad86842a5e7da0cd1d071c, type: 3}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "白骨精"
    content: "没想到孙悟空赶回来，弄破我的勾当，又几乎被他打了一棒。"
    portrait: {fileID: 21300000, guid: b7f63495ebad86842a5e7da0cd1d071c, type: 3}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "白骨精"
    content: "若饶了这个和尚，不就是无功而返，我还下去戏他一戏。"
    portrait: {fileID: 21300000, guid: b7f63495ebad86842a5e7da0cd1d071c, type: 3}
    nextIndex: 0
    choices:
    - choiceText: "结束对话"
      targetIndex: -1
      broadcastEvent: 0
    broadcastOnShow: 0
    broadcastEventKey: 
  title: 
  author: 
