%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 934c1ef0cd8351447bfb2eeb8c16fb23, type: 3}
  m_Name: "唐僧（第三幕）"
  m_EditorClassIdentifier: 
  dialoguePieces:
  - speaker: "猪八戒"
    content: "这女子没气了！"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "悟空！你为何无故伤人？"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "师父，我打的是妖怪"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "这 这分明是良家女子。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "师父，我若来迟，你定入他套子，遭他毒手！"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "沙和尚"
    content: "大师兄火眼金睛，不会有错的。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "猪八戒"
    content: "管他妖不妖精，这篮子饭食，正好咱们受用了。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "沙和尚"
    content: "二师兄，你怎么啃起来石头了"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "师父你看这罐子里是甚东西。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "【悟空又火眼金睛，自然不会认错，这篮中的包子又变成石头，想来是不会有错的】"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "八戒"
    content: "师父，说起这个女子，她是此间农妇，"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "八戒"
    content: "因为送饭下田，路遇我等，却怎么栽他是个妖怪？"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "猪八戒"
    content: "哥哥的棍重，走将来试手打他一下，不想就打死了；"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "猪八戒"
    content: "怕你念什么《紧箍儿咒》，故意的使个障眼法儿，"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "猪八戒"
    content: "变做这等样东西，幌你眼，让你不念咒哩"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "头疼！头疼！莫念！莫念！有话便说。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "有什么话说！出家人时时常要方便，"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "念念不离善心，扫地恐伤蝼蚁命，爱惜飞蛾纱罩灯。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "你怎么步步行凶，打死这个无故杀人，"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "取来真经又有何用？你回去罢！"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "悟孙空"
    content: "师父，你叫我回那里去？"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "我不要你做徒弟了。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "你不要我做徒弟，只怕你西天路去不成。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "我命在天，该那个妖精蒸了吃，"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "就是煮了，也算不到你投上去。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "师父，我回去便也罢了，只是不曾报得你的恩。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "我与你有什么恩？"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "俺老孙因大闹天宫，犯下了天条，"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "被佛祖压在两界山，幸得观音菩萨让我受了戒行。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "又幸得师父救脱，若不与你同上西天，"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "显得我知恩不报非君子，万古千秋作骂名。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "【悟空也是可怜，我且饶这泼猴一回】"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "既如此说了，就且饶你这一次，休得再次无礼。"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "唐僧"
    content: "如若仍前作恶，这咒语颠倒就念二十遍！"
    portrait: {fileID: 0}
    nextIndex: 0
    choices: []
    broadcastOnShow: 0
    broadcastEventKey: 
  - speaker: "孙悟空"
    content: "师父，吃桃，吃桃"
    portrait: {fileID: 0}
    nextIndex: 0
    choices:
    - choiceText: "结束对话"
      targetIndex: -1
      broadcastEvent: 0
    broadcastOnShow: 0
    broadcastEventKey: 
  title: 
  author: 
